{
  "manifest_version": 3,
  "name": "Recall-All — Reading Companion",
  "version": "0.2.0",
  "description": "Collect likely-read sections on sites you explicitly approve. Requires the local Recall-All app.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall-All"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "reading.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}